///|
/// Scenario 1 and 2 input: a 4x4 eight-bit truecolor PNG produced by an
/// independent encoder. Pixel (x, y) holds (10 + 40x, 20 + 40y, 200).
let icon_png : Bytes = b"\x89\x50\x4e\x47\x0d\x0a\x1a\x0a\x00\x00\x00\x0d\x49\x48\x44\x52\x00\x00\x00\x04\x00\x00\x00\x04\x08\x02\x00\x00\x00\x26\x93\x09\x29\x00\x00\x00\x01\x73\x52\x47\x42\x00\xae\xce\x1c\xe9\x00\x00\x00\x04\x67\x41\x4d\x41\x00\x00\xb1\x8f\x0b\xfc\x61\x05\x00\x00\x00\x09\x70\x48\x59\x73\x00\x00\x0e\xc3\x00\x00\x0e\xc3\x01\xc7\x6f\xa8\x64\x00\x00\x00\x32\x49\x44\x41\x54\x18\x57\x05\xc1\x21\x01\x00\x00\x08\x04\xb1\xd7\x68\x92\xa0\x49\x82\x26\xc9\x6b\x82\x5d\x2c\x36\x45\x52\xc9\x24\x4e\x14\x4d\x35\xd3\xb8\x51\x2c\xb5\xcc\xe2\x45\x71\xd4\x31\x87\x8f\x07\xfe\xe3\x15\xe1\xc3\xdd\xa0\x96\x00\x00\x00\x00\x49\x45\x4e\x44\xae\x42\x60\x82"

///|
/// Scenario 3 input: an 8x8 baseline grayscale JPEG produced by Pillow 11.1.0.
let photo_jpeg : Bytes = b"\xff\xd8\xff\xe0\x00\x10\x4a\x46\x49\x46\x00\x01\x01\x00\x00\x01\x00\x01\x00\x00\xff\xdb\x00\x43\x00\x02\x01\x01\x01\x01\x01\x02\x01\x01\x01\x02\x02\x02\x02\x02\x04\x03\x02\x02\x02\x02\x05\x04\x04\x03\x04\x06\x05\x06\x06\x06\x05\x06\x06\x06\x07\x09\x08\x06\x07\x09\x07\x06\x06\x08\x0b\x08\x09\x0a\x0a\x0a\x0a\x0a\x06\x08\x0b\x0c\x0b\x0a\x0c\x09\x0a\x0a\x0a\xff\xc0\x00\x0b\x08\x00\x08\x00\x08\x01\x01\x11\x00\xff\xc4\x00\x1f\x00\x00\x01\x05\x01\x01\x01\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\xff\xc4\x00\xb5\x10\x00\x02\x01\x03\x03\x02\x04\x03\x05\x05\x04\x04\x00\x00\x01\x7d\x01\x02\x03\x00\x04\x11\x05\x12\x21\x31\x41\x06\x13\x51\x61\x07\x22\x71\x14\x32\x81\x91\xa1\x08\x23\x42\xb1\xc1\x15\x52\xd1\xf0\x24\x33\x62\x72\x82\x09\x0a\x16\x17\x18\x19\x1a\x25\x26\x27\x28\x29\x2a\x34\x35\x36\x37\x38\x39\x3a\x43\x44\x45\x46\x47\x48\x49\x4a\x53\x54\x55\x56\x57\x58\x59\x5a\x63\x64\x65\x66\x67\x68\x69\x6a\x73\x74\x75\x76\x77\x78\x79\x7a\x83\x84\x85\x86\x87\x88\x89\x8a\x92\x93\x94\x95\x96\x97\x98\x99\x9a\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xff\xda\x00\x08\x01\x01\x00\x00\x3f\x00\x6f\xfc\x9c\x87\xfd\x5c\x9f\xfc\x34\x9f\xfd\xc9\xdf\xf0\xd9\x3f\xf0\x8f\x7f\xdf\x1f\xf0\xaf\x3f\xe1\x12\xf2\xbf\xe9\x8f\xf6\xdf\xd9\x7f\xe5\xa7\x99\xcf\xff\xd9"

///|
/// Scenario 1: decode a PNG datastream into a raster the caller can inspect.
fn decode_png(bytes : Bytes) -> @image.Image raise {
  let image = @png.decode(bytes)
  println(
    "PNG header: \{image.width}x\{image.height}, \{image.bit_depth}-bit, " +
    "\{image.channels()} channel(s)",
  )
  println(
    "first pixel: (\{image.pixels[0].to_int()}, \{image.pixels[1].to_int()}, " +
    "\{image.pixels[2].to_int()})",
  )
  image
}

///|
/// Scenario 2: serialise the raster back into PNG and verify the round trip.
fn encode_png(image : @image.Image) -> Unit raise {
  let encoded = @png.encode(image)
  println("encoded PNG: \{encoded.length()} bytes")
  let decoded = @png.decode(encoded)
  let mut same = decoded.width == image.width &&
    decoded.height == image.height &&
    decoded.pixels.length() == image.pixels.length()
  let mut i = 0
  while i < image.pixels.length() {
    if decoded.pixels[i] != image.pixels[i] {
      same = false
    }
    i = i + 1
  }
  let verdict = if same { "samples identical" } else { "SAMPLES DIFFER" }
  println("round trip: \{verdict}")
}

///|
/// Scenario 3: decode a baseline JPEG photo into the same image model.
fn decode_jpeg(bytes : Bytes) -> Unit raise {
  let image = @png_jpeg.decode(bytes)
  println(
    "decoded JPEG: \{image.width}x\{image.height}, \{image.channels()} channel(s)",
  )
  let mut sum = 0
  let mut i = 0
  while i < image.pixels.length() {
    sum = sum + image.pixels[i].to_int()
    i = i + 1
  }
  let count = image.pixels.length()
  println(
    "gray samples: first=\{image.pixels[0].to_int()}, " +
    "last=\{image.pixels[count - 1].to_int()}, mean=\{sum / count}",
  )
}

///|
fn main {
  try {
    let image = decode_png(icon_png)
    encode_png(image)
    decode_jpeg(photo_jpeg)
  } catch {
    err => println("example failed: \{err}")
  }
}
