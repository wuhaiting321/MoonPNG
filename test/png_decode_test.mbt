///|
/// Assert the geometry of a decoded PngSuite image and the CRC-32 of its packed
/// sample raster, both taken from an independent CPython oracle.
fn assert_pngsuite(
  image : @image.Image,
  depth : Int,
  color : @image.ColorType,
  checksum : UInt,
) -> Unit raise {
  assert_eq(image.width, 32)
  assert_eq(image.height, 32)
  assert_eq(image.bit_depth, depth)
  assert_eq(image.color_type, color)
  assert_eq(@zlib.crc32(image.pixels), checksum)
}

///|
test "decodes the PngSuite baseline corpus at every bit depth" {
  assert_pngsuite(
    @png.decode(basn0g01),
    1,
    @image.ColorType::Grayscale,
    0xB71A0667U,
  )
  assert_pngsuite(
    @png.decode(basn0g04),
    4,
    @image.ColorType::Grayscale,
    0x8089A6E9U,
  )
  assert_pngsuite(
    @png.decode(basn0g16),
    16,
    @image.ColorType::Grayscale,
    0x9362F0F0U,
  )
  assert_pngsuite(
    @png.decode(basn3p01),
    1,
    @image.ColorType::Indexed,
    0xB3189A91U,
  )
  assert_pngsuite(
    @png.decode(basn2c16),
    16,
    @image.ColorType::Truecolor,
    0xC278125AU,
  )
  assert_pngsuite(
    @png.decode(basn6a08),
    8,
    @image.ColorType::TruecolorAlpha,
    0xA74DF32CU,
  )
}

///|
test "de-interlaces Adam7 datastreams into the progressive raster" {
  let pairs : Array[(Bytes, Bytes)] = [
    (basn0g01, basi0g01),
    (basn0g04, basi0g04),
    (basn0g16, basi0g16),
    (basn3p01, basi3p01),
    (basn2c16, basi2c16),
    (basn6a08, basi6a08),
  ]
  let mut i = 0
  while i < pairs.length() {
    let progressive = @png.decode(pairs[i].0)
    let interlaced = @png.decode(pairs[i].1)
    assert_eq(interlaced.pixels, progressive.pixels)
    i = i + 1
  }
}
