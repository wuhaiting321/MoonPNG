/// 4x4 eight-bit truecolor: pixel (x, y) holds (10 + 40x, 20 + 40y, 200).
let rgb24 : Bytes = b"\x89\x50\x4e\x47\x0d\x0a\x1a\x0a\x00\x00\x00\x0d\x49\x48\x44\x52\x00\x00\x00\x04\x00\x00\x00\x04\x08\x02\x00\x00\x00\x26\x93\x09\x29\x00\x00\x00\x01\x73\x52\x47\x42\x00\xae\xce\x1c\xe9\x00\x00\x00\x04\x67\x41\x4d\x41\x00\x00\xb1\x8f\x0b\xfc\x61\x05\x00\x00\x00\x09\x70\x48\x59\x73\x00\x00\x0e\xc3\x00\x00\x0e\xc3\x01\xc7\x6f\xa8\x64\x00\x00\x00\x32\x49\x44\x41\x54\x18\x57\x05\xc1\x21\x01\x00\x00\x08\x04\xb1\xd7\x68\x92\xa0\x49\x82\x26\xc9\x6b\x82\x5d\x2c\x36\x45\x52\xc9\x24\x4e\x14\x4d\x35\xd3\xb8\x51\x2c\xb5\xcc\xe2\x45\x71\xd4\x31\x87\x8f\x07\xfe\xe3\x15\xe1\xc3\xdd\xa0\x96\x00\x00\x00\x00\x49\x45\x4e\x44\xae\x42\x60\x82"

