let rgba32 : Bytes = b"\x89\x50\x4e\x47\x0d\x0a\x1a\x0a\x00\x00\x00\x0d\x49\x48\x44\x52\x00\x00\x00\x04\x00\x00\x00\x04\x08\x06\x00\x00\x00\xa9\xf1\x9e\x7e\x00\x00\x00\x01\x73\x52\x47\x42\x00\xae\xce\x1c\xe9\x00\x00\x00\x04\x67\x41\x4d\x41\x00\x00\xb1\x8f\x0b\xfc\x61\x05\x00\x00\x00\x09\x70\x48\x59\x73\x00\x00\x0e\xc3\x00\x00\x0e\xc3\x01\xc7\x6f\xa8\x64\x00\x00\x00\x35\x49\x44\x41\x54\x18\x57\x05\xc1\x01\x01\x00\x00\x0c\x01\x30\x71\xc4\x11\xe7\x85\x24\x91\x44\x12\xdf\x00\x6c\xc4\x2a\x2c\x87\x19\x60\x47\xb6\x62\x73\xac\x01\x65\x54\x2a\x25\xa7\x18\x38\x8f\xe7\xea\x9c\x3b\xfb\x01\x58\xd8\x21\xc1\xef\x1a\x71\x9d\x00\x00\x00\x00\x49\x45\x4e\x44\xae\x42\x60\x82"

///|
test "decodes an eight-bit truecolor image" {
  let image = @png.decode(rgb24)
  assert_eq(image.width, 4)
  assert_eq(image.height, 4)
  assert_eq(image.bit_depth, 8)
  assert_eq(image.color_type, @image.ColorType::Truecolor)
  assert_eq(image.pixels.length(), 48)
  let expected : Array[Int] = [
    10, 20, 200, 50, 20, 200, 90, 20, 200, 130, 20, 200, 10, 60, 200, 50, 60, 200,
    90, 60, 200, 130, 60, 200, 10, 100, 200, 50, 100, 200, 90, 100, 200, 130, 100,
    200, 10, 140, 200, 50, 140, 200, 90, 140, 200, 130, 140, 200,
  ]
  let mut i = 0
  while i < expected.length() {
    assert_eq(image.pixels[i].to_int(), expected[i])
    i = i + 1
  }
}

///|
test "decodes an eight-bit truecolor image with alpha" {
  let image = @png.decode(rgba32)
  assert_eq(image.color_type, @image.ColorType::TruecolorAlpha)
  assert_true(image.has_transparency())
  assert_eq(image.pixels.length(), 64)
  let expected : Array[Int] = [
    0, 0, 255, 255, 40, 0, 255, 225, 80, 0, 255, 195, 120, 0, 255, 165, 0, 40, 225,
    255, 40, 40, 225, 225, 80, 40, 225, 195, 120, 40, 225, 165, 0, 80, 195, 255,
    40, 80, 195, 225, 80, 80, 195, 195, 120, 80, 195, 165, 0, 120, 165, 255, 40,
    120, 165, 225, 80, 120, 165, 195, 120, 120, 165, 165,
  ]
  let mut i = 0
  while i < expected.length() {
    assert_eq(image.pixels[i].to_int(), expected[i])
    i = i + 1
  }
}

///|
test "inflates a stored DEFLATE block" {
  let stream : Bytes = b"\x78\x01\x01\x05\x00\xfa\xffhello\x06\x2c\x02\x15"
  assert_eq(@zlib.inflate_zlib(stream), b"hello")
}

///|
test "inflates a fixed-code DEFLATE block" {
  let stream : Bytes = b"\x78\x01\x73\x74\x02\x00\x00\xc6\x00\x84"
  assert_eq(@zlib.inflate_zlib(stream), b"AB")
}

///|
test "rejects a datastream with a broken chunk checksum" {
  let bytes = rgb24.to_array()
  let last = bytes.length() - 1
  bytes[last] = (bytes[last].to_int() ^ 0x01).to_byte()
  let caught = try {
    let _ = @png.decode(Bytes::from_array(bytes))
    false
  } catch {
    @png_decode.PngDecodeError::BadChunk(_) => true
    _ => false
  }
  assert_true(caught)
}

///|
test "rejects data that is not a PNG datastream" {
  let caught = try {
    let _ = @png.decode(b"GIF89a and then some")
    false
  } catch {
    @png_decode.PngDecodeError::NotPng => true
    _ => false
  }
  assert_true(caught)
}

