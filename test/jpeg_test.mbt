let rgb420_odd_expected : Bytes = b"\x12\x1f\xc6\x1c\x1f\xc6\x29\x1f\xc0\x36\x1f\xb8\x40\x20\xb1\x4b\x21\xab\x59\x20\xa5\x67\x1e\xa1\x73\x1d\x98\x7e\x1f\x93\x89\x1f\x8b\x94\x20\x85\xa0\x1f\x83\x16\x29\xc3\x1f\x29\xbf\x2d\x29\xbb\x3a\x29\xb3\x43\x2a\xac\x4e\x2a\xa6\x5c\x29\xa0\x6b\x28\x9b\x76\x27\x94\x81\x29\x8d\x8d\x2a\x87\x97\x29\x80\xa3\x29\x7e\x17\x35\xb9\x22\x35\xb6\x2f\x35\xb1\x3a\x35\xab\x44\x37\xa3\x4f\x36\x9c\x5e\x36\x97\x6b\x34\x91\x78\x34\x8b\x83\x34\x83\x8d\x36\x7d\x99\x36\x77\xa4\x36\x75\x16\x41\xb2\x21\x41\xb0\x2e\x41\xaa\x39\x41\xa3\x43\x43\x9b\x4f\x43\x95\x5d\x42\x91\x6a\x40\x8a\x77\x40\x84\x83\x41\x7e\x8c\x42\x75\x98\x42\x71\xa3\x42\x6f\x16\x4e\xaf\x20\x4e\xac\x2c\x4e\xa7\x39\x4e\xa1\x42\x4e\x98\x4e\x4f\x92\x5d\x4f\x8d\x6a\x4c\x88\x77\x4c\x81\x81\x4d\x7b\x8b\x4f\x73\x98\x4f\x6d\xa3\x4e\x6b\x15\x59\xaa\x1f\x5a\xa8\x2b\x5a\xa2\x37\x5a\x9c\x40\x5a\x93\x4b\x5b\x8e\x5a\x5b\x89\x68\x59\x84\x74\x59\x7c\x80\x59\x76\x8a\x5b\x6f\x95\x5b\x69\xa1\x5b\x66\x15\x67\xa3\x1e\x66\xa0\x2b\x67\x9b\x36\x66\x94\x41\x67\x8c\x4d\x68\x86\x59\x67\x81\x69\x65\x7c\x75\x64\x74\x80\x66\x6f\x8a\x68\x67\x96\x66\x62\xa0\x67\x5e\x15\x72\x9b\x1e\x72\x97\x2c\x73\x93\x39\x73\x8b\x42\x73\x84\x4d\x73\x7e\x5c\x73\x79\x69\x71\x73\x76\x71\x6d\x80\x72\x65\x8a\x74\x5f\x97\x73\x59\xa2\x73\x57\x17\x7d\x96\x21\x7d\x94\x2f\x7c\x8e\x3a\x7c\x88\x44\x7e\x80\x50\x7e\x7b\x5e\x7d\x75\x6c\x7c\x71\x79\x7c\x6b\x82\x7c\x62\x8d\x7d\x5b\x9a\x7e\x57\xa4\x7d\x54"

///|
/// The largest absolute difference between two sample streams of the same length.
fn max_error(actual : Bytes, expected : Bytes) -> Int raise {
  assert_eq(actual.length(), expected.length())
  let mut worst = 0
  let mut i = 0
  while i < actual.length() {
    let delta = actual[i].to_int() - expected[i].to_int()
    let magnitude = if delta < 0 { -delta } else { delta }
    if magnitude > worst {
      worst = magnitude
    }
    i = i + 1
  }
  worst
}

///|
/// The first `count` bytes of `data`, so a test can cut a datastream short.
fn first_bytes(data : Bytes, count : Int) -> Bytes {
  let out : Array[Byte] = []
  let mut i = 0
  while i < count && i < data.length() {
    out.push(data[i])
    i = i + 1
  }
  Bytes::from_array(out)
}

///|
/// Copy `data` with the frame marker rewritten to `code`, so a test can present
/// a frame type the baseline decoder must refuse while the rest stays valid.
fn with_frame_marker(data : Bytes, code : Int) -> Bytes {
  let out : Array[Byte] = []
  let mut i = 0
  while i < data.length() {
    out.push(data[i])
    i = i + 1
  }
  i = 0
  while i + 1 < data.length() {
    if data[i] == b'\xff' && data[i + 1] == b'\xc0' {
      out[i + 1] = code.to_byte()
      break
    }
    i = i + 1
  }
  Bytes::from_array(out)
}

///|
test "baseline jpeg decodes a grayscale frame exactly" {
  let image = @png_jpeg.decode(gray8)
  assert_eq(image.width, 8)
  assert_eq(image.height, 8)
  assert_true(image.color_type is @image.ColorType::Grayscale)
  assert_eq(image.pixels, gray8_expected)
}

///|
test "baseline jpeg decodes a 4:4:4 frame" {
  let image = @png_jpeg.decode(rgb444)
  assert_true(image.color_type is @image.ColorType::Truecolor)
  assert_eq(image.width, 8)
  assert_eq(image.height, 8)
  assert_true(max_error(image.pixels, rgb444_expected) <= 2)
}

///|
/// The subsampled cases are compared with a wider tolerance: this decoder
/// replicates the nearest chroma sample, whereas Pillow interpolates, so the
/// two legitimately disagree along colour edges. Neither may drift further than
/// a few levels, though.
test "baseline jpeg upsamples 4:2:2 chroma" {
  let image = @png_jpeg.decode(rgb422)
  assert_eq(image.pixels.length(), 8 * 8 * 3)
  assert_true(max_error(image.pixels, rgb422_expected) <= 8)
}

///|
test "baseline jpeg upsamples 4:2:0 chroma" {
  let image = @png_jpeg.decode(rgb420)
  assert_eq(image.pixels.length(), 8 * 8 * 3)
  assert_true(max_error(image.pixels, rgb420_expected) <= 16)
}

///|
/// A frame whose width and height do not fill whole MCUs exercises the padded
/// blocks at the right and bottom edges.
test "baseline jpeg decodes a frame that does not fill whole MCUs" {
  let image = @png_jpeg.decode(rgb420_odd)
  assert_eq(image.width, 13)
  assert_eq(image.height, 9)
  assert_eq(image.pixels.length(), 13 * 9 * 3)
  assert_true(max_error(image.pixels, rgb420_odd_expected) <= 16)
}

///|
test "restart markers do not change the decoded picture" {
  let smooth = @png_jpeg.decode(rgb420)
  let restarted = @png_jpeg.decode(rgb420_restart)
  assert_eq(restarted.pixels, smooth.pixels)
  assert_true(max_error(restarted.pixels, rgb420_restart_expected) <= 16)
}

///|
test "jpeg signature detection" {
  assert_true(@png_jpeg.is_jpeg(rgb444))
  assert_false(@png_jpeg.is_jpeg(b"GIF89a"))
  assert_false(@png_jpeg.is_jpeg(b""))
}

///|
test "non jpeg data is rejected" {
  let caught = try {
    let _ = @png_jpeg.decode(b"not a jpeg at all")
    false
  } catch {
    @png_jpeg.JpegDecodeError::NotJpeg => true
    _ => false
  }
  assert_true(caught)
}

///|
test "a truncated datastream is rejected" {
  let caught = try {
    let _ = @png_jpeg.decode(first_bytes(rgb444, 40))
    false
  } catch {
    @png_jpeg.JpegDecodeError::BadData(_) => true
    _ => false
  }
  assert_true(caught)
}

///|
test "a progressive frame is rejected" {
  let caught = try {
    let _ = @png_jpeg.decode(with_frame_marker(rgb444, 0xC2))
    false
  } catch {
    @png_jpeg.JpegDecodeError::BadData(_) => true
    _ => false
  }
  assert_true(caught)
}
