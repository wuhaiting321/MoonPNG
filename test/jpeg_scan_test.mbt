///|
let cmyk_two_scans_rgb : Bytes = b"\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00\xff\x87\x00"

///|
/// The prefix of `data` that ends just before its `index`-th SOS marker, so a
/// test can present a frame that stops short of scanning every component.
fn cut_before_scan(data : Bytes, index : Int) -> Bytes {
  let out : Array[Byte] = []
  let mut scans = 0
  let mut i = 0
  while i + 1 < data.length() {
    if data[i] == b'\xff' && data[i + 1] == b'\xda' && scans == index {
      break
    }
    if data[i] == b'\xff' && data[i + 1] == b'\xda' {
      scans = scans + 1
    }
    out.push(data[i])
    i = i + 1
  }
  Bytes::from_array(out)
}

///|
test "four component frame is converted from cmyk ink" {
  let image = @png_jpeg.decode(cmyk_four_component)
  assert_eq(image.width, 8)
  assert_eq(image.height, 8)
  assert_true(image.color_type is @image.ColorType::Truecolor)
  assert_true(max_error(image.pixels, cmyk_four_component_rgb) <= 1)
}

///|
test "sequential scans accumulate into one picture" {
  let image = @png_jpeg.decode(multiscan_ycbcr)
  assert_eq(image.width, 16)
  assert_eq(image.height, 8)
  assert_true(image.color_type is @image.ColorType::Truecolor)
  assert_eq(image.pixels, multiscan_ycbcr_rgb)
}

///|
test "two component frame becomes gray plus alpha" {
  let image = @png_jpeg.decode(two_component)
  assert_eq(image.width, 8)
  assert_eq(image.height, 8)
  assert_true(image.color_type is @image.ColorType::GrayscaleAlpha)
  assert_eq(image.pixels, two_component_pixels)
}

///|
test "four components may arrive in separate scans" {
  let image = @png_jpeg.decode(cmyk_two_scans)
  assert_eq(image.width, 8)
  assert_eq(image.height, 8)
  assert_true(image.color_type is @image.ColorType::Truecolor)
  assert_eq(image.pixels, cmyk_two_scans_rgb)
}

///|
/// A sequential frame is only complete once every component has been scanned;
/// stopping after the second of three scans must not yield a partial picture.
test "a frame with an unscanned component is rejected" {
  let partial = cut_before_scan(multiscan_ycbcr, 2)
  let caught = try {
    let _ = @png_jpeg.decode(partial)
    false
  } catch {
    @png_jpeg.JpegDecodeError::BadData(_) => true
    _ => false
  }
  assert_true(caught)
}
